# Copy to .env and uncomment what you need. Every variable is optional.
#
# Where .env lives: in a git checkout, next to app.py. In an installed copy
# (uv tool install), in the user config directory - `f1dash paths` prints it.
# Real environment variables win over this file.
# tests/test_env_example.py fails when the code reads a variable not listed here.

# --- Live timing ----------------------------------------------------------

# F1TV subscription token for car telemetry and positions (CarData.z,
# Position.z). The free feed works without it. Paste the JWT, or the value
# of the formula1.com `login-session` cookie. It stays on this machine: it is
# sent only to livetiming.formula1.com and never logged.
# F1TV_SUBSCRIPTION_TOKEN=

# Show the process-wide Connect/Stop/Clear controls to every viewer, not only
# to localhost (1 = show).
# F1_LIVE_CONTROLS=0

# Record the raw live feed into the replay folder as soon as a session starts
# (1 = on, the default; 0 = off).
# F1_LIVE_AUTORECORD=1

# --- Files and folders ----------------------------------------------------
# Defaults: repo-local in a checkout (./ff1_cache, ./replay_sessions,
# ./metrics_store.sqlite), the per-user directories in an installed copy.

# FastF1's HTTP and session cache.
# FASTF1_CACHE_DIR=./ff1_cache

# Saved and recorded replays.
# REPLAY_DIR=./replay_sessions

# The persistent records store (fastest lap, sectors, top speed).
# F1_METRICS_STORE=./metrics_store.sqlite

# --- Session defaults -----------------------------------------------------

# DEFAULT_YEAR=2024
# DEFAULT_GP=Abu Dhabi
# DEFAULT_SESSION=R

# --- Behaviour ------------------------------------------------------------

# Logging for the adapters' degraded paths: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=WARNING

# Replay player: browser (smooth playback in the browser, the default) or
# server (the Python-rendered fallback).
# F1_REPLAY_PLAYER=browser

# Process-lifetime session cache bounds: number of sessions, and bytes.
# F1_CACHE_MAX_ENTRIES=8
# F1_CACHE_MAX_BYTES=1073741824

# Check GitHub once a day for a newer release (0 = never ask).
# F1_UPDATE_CHECK=1

# --- Development ----------------------------------------------------------

# Opt in to the tests that reach FastF1, Jolpica and the network.
# F1_NETWORK_TESTS=1
